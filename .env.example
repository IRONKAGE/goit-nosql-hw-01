# ==============================================================================
# 🌍 ENVIRONMENT VARIABLES (Spotify Analytics Platform) by IRONKAGE
# ==============================================================================
# УВАГА: Файл .env додано до .gitignore.
# Заповніть цей шаблон реальними даними та збережіть як .env

# --- 1. Режим роботи (Яку базу використовують Python-скрипти) ---
# Доступні значення: local (Docker) або cloud (Atlas)
ACTIVE_ENV=local  # 'local' для локальної бази або 'cloud' для хмарної (Atlas)

# --- 2. Креди для інфраструктури Docker (compose.yml) ---
# Використовується, якщо ви обрали захищений Standalone-варіант бази
MONGO_USER=admin
MONGO_PASS=SuperSecretPassword2026!

# Креди для входу у веб-адмінку Mongo Express (http://127.0.0.1:8081)
ME_AUTH_USER=admin
ME_AUTH_PASS=admin_password_123

# --- 3. Рядки підключення (Connection Strings) для Python ---
# Варіант А: Для кластера з 3-х нод (Replica Set) без пароля:
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/spotify?directConnection=true

# Варіант Б: Для Standalone бази (з логіном та паролем):
# MONGO_LOCAL_URI=mongodb://admin:SuperSecretPassword2026!@127.0.0.1:27017/spotify?authSource=admin

# Хмарний URI (MongoDB Atlas) - вставте свій реальний рядок підключення
MONGO_CLOUD_URI=mongodb+srv://<твій_юзер>:<твій_пароль>@cluster.mongodb.net/

# --- 4. Kaggle API Credentials (ОПЦІОНАЛЬНО) ---
# Якщо ці поля порожні або відсутні, завантаження відбудеться напряму (без API)
KAGGLE_USERNAME=
KAGGLE_KEY=
